{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "emulicious-debugger",
            "request": "launch",
            "name": "Launch in Emulicious (with Java32)",
            "emuliciousPath": "${workspaceFolder}/emulicious-with-Java32/emulicious.jar",
            "program": "${workspaceFolder}/main.gb",            
            "port": 58870,
            "stopOnEntry": true
        },
        {
            "type": "emulicious-debugger",
            "request": "launch",
            "name": "Launch in Emulicious (with Java64)",
            "emuliciousPath": "${workspaceFolder}/emulicious-with-Java64/emulicious.jar",
            "program": "${workspaceFolder}/main.gb",            
            "port": 58870,
            "stopOnEntry": true
        },
        {
            "type": "emulicious-debugger",
            "request": "launch",
            "name": "Launch in Emulicious (Java is already installed)",
            "emuliciousPath": "${workspaceFolder}/emulicious/emulicious.jar",
            "program": "${workspaceFolder}/main.gb",
            "port": 58870,
            "stopOnEntry": true
        }
    ]
}